{
  "name": "sams_kitchen_app",
  "description": "Full-stack restaurant ordering app for Sam's Kitchen with noodles dinner specials, Indian appetizers, Italian mains, secure auth, and Stripe payments",
  "tech": {
    "backend_port": 8000,
    "frontend_port": 3000,
    "api_base_url": "http://localhost:8000/api",
    "auth_strategy": "jwt",
    "state_management": "context",
    "database": "sqlite3",
    "css_framework": "none",
    "project_type": "fullstack_express",
    "game_engine": "",
    "game_interfaces": {},
    "frontend_framework": "react",
    "python_packages": [],
    "node_packages": {
      "axios": "^1.6.0",
      "react-router-dom": "^6.20.0",
      "@stripe/stripe-js": "^2.4.0",
      "@stripe/react-stripe-js": "^2.4.0",
      "express": "^4.18.2",
      "prisma": "^5.7.0",
      "@prisma/client": "^5.7.0",
      "jsonwebtoken": "^9.0.2",
      "bcryptjs": "^2.4.3",
      "cors": "^2.8.5",
      "helmet": "^7.1.0",
      "express-rate-limit": "^7.1.5",
      "stripe": "^14.9.0",
      "dotenv": "^16.3.1"
    },
    "typescript": true,
    "user_roles": [],
    "production_security": true,
    "google_oauth": false,
    "payments": true,
    "payments_effect": false
  },
  "models": [
    {
      "name": "Category",
      "app_label": "api",
      "fields": [
        {
          "name": "name",
          "type": "CharField",
          "kwargs": {
            "max_length": "100"
          }
        },
        {
          "name": "slug",
          "type": "SlugField",
          "kwargs": {
            "max_length": "120",
            "unique": "True"
          }
        },
        {
          "name": "description",
          "type": "TextField",
          "kwargs": {
            "blank": "True"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        },
        {
          "name": "updated_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['name']"
      },
      "str_field": "name"
    },
    {
      "name": "MenuItem",
      "app_label": "api",
      "fields": [
        {
          "name": "name",
          "type": "CharField",
          "kwargs": {
            "max_length": "200"
          }
        },
        {
          "name": "description",
          "type": "TextField",
          "kwargs": {
            "blank": "True"
          }
        },
        {
          "name": "price",
          "type": "DecimalField",
          "kwargs": {
            "max_digits": "8",
            "decimal_places": "2"
          }
        },
        {
          "name": "category",
          "type": "ForeignKey",
          "kwargs": {
            "to": "'Category'",
            "on_delete": "models.CASCADE",
            "related_name": "'menu_items'"
          }
        },
        {
          "name": "image_url",
          "type": "URLField",
          "kwargs": {
            "blank": "True"
          }
        },
        {
          "name": "is_special",
          "type": "BooleanField",
          "kwargs": {
            "default": "False"
          }
        },
        {
          "name": "is_available",
          "type": "BooleanField",
          "kwargs": {
            "default": "True"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        },
        {
          "name": "updated_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['category', 'name']"
      },
      "str_field": "name"
    },
    {
      "name": "Order",
      "app_label": "api",
      "fields": [
        {
          "name": "user",
          "type": "ForeignKey",
          "kwargs": {
            "to": "'User'",
            "on_delete": "models.CASCADE",
            "related_name": "'orders'"
          }
        },
        {
          "name": "status",
          "type": "CharField",
          "kwargs": {
            "max_length": "20",
            "default": "'pending'"
          }
        },
        {
          "name": "total_amount",
          "type": "DecimalField",
          "kwargs": {
            "max_digits": "10",
            "decimal_places": "2"
          }
        },
        {
          "name": "stripe_payment_intent",
          "type": "CharField",
          "kwargs": {
            "max_length": "255",
            "blank": "True"
          }
        },
        {
          "name": "stripe_checkout_session_id",
          "type": "CharField",
          "kwargs": {
            "max_length": "255",
            "blank": "True"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        },
        {
          "name": "updated_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['-created_at']"
      },
      "str_field": "id"
    },
    {
      "name": "OrderItem",
      "app_label": "api",
      "fields": [
        {
          "name": "order",
          "type": "ForeignKey",
          "kwargs": {
            "to": "'Order'",
            "on_delete": "models.CASCADE",
            "related_name": "'items'"
          }
        },
        {
          "name": "menu_item",
          "type": "ForeignKey",
          "kwargs": {
            "to": "'MenuItem'",
            "on_delete": "models.PROTECT",
            "related_name": "'order_items'"
          }
        },
        {
          "name": "quantity",
          "type": "PositiveIntegerField",
          "kwargs": {
            "default": "1"
          }
        },
        {
          "name": "price",
          "type": "DecimalField",
          "kwargs": {
            "max_digits": "8",
            "decimal_places": "2"
          }
        },
        {
          "name": "created_at",
          "type": "DateTimeField",
          "kwargs": {
            "auto_now_add": "True"
          }
        }
      ],
      "meta": {
        "ordering": "['id']"
      },
      "str_field": "id"
    }
  ],
